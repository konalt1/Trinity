	// Stacked camp crowd noise: CrowdN = N stacks (6 = 6+). 3D at the camp: loudness follows the camera, not the hero.
	// Each file is an 8 s piece with baked 2 s equal-power fades; Lua re-emits every 6 s, alternating CrowdN / CrowdN.Alt
	// so a new piece never cuts off the previous one of the same event. Keep volumes of a pair equal.
	Trinity.StackedCamp.Crowd1 =
	{
		type = "dota_src1_3d"
		vsnd_files = [ "sounds/stacked_camp/crowd_01.vsnd", "sounds/stacked_camp/crowd_02.vsnd", "sounds/stacked_camp/crowd_03.vsnd", "sounds/stacked_camp/crowd_04.vsnd", "sounds/stacked_camp/crowd_05.vsnd", "sounds/stacked_camp/crowd_06.vsnd", "sounds/stacked_camp/crowd_07.vsnd", "sounds/stacked_camp/crowd_08.vsnd" ]
		volume = 0.8
	}

